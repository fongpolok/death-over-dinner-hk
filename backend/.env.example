# Copy this file to backend/.env and fill in real values to enable actual
# invitation-email sending (item 9.6). backend/.env is gitignored -- never
# commit real credentials. Without this file (or these variables set some
# other way), /api/send-invitation still works, but honestly reports
# "logged_not_configured" instead of pretending to have sent anything.

# Example for Gmail: generate an "App Password" at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification),
# and use that here -- not your normal account password.
DOD_SMTP_HOST=smtp.gmail.com
DOD_SMTP_PORT=587
DOD_SMTP_USER=your-address@gmail.com
DOD_SMTP_PASSWORD=your-16-char-app-password
DOD_SMTP_FROM_EMAIL=your-address@gmail.com
DOD_SMTP_FROM_NAME=三渡棧 Mementos

# Inbox that contact-page enquiries are emailed to (needs the SMTP settings
# above). Leave unset and enquiries are still logged, just not emailed.
DOD_ENQUIRY_TO_EMAIL=hello@your-domain.example
